VITE_API_URL=https://kult-browser-rust-l2lwg.ondigitalocean.app

# Social share previews (required for images on X/Facebook/WhatsApp/Reddit):
# - Copy link + platform buttons use /api/share/moments/:id (crawlable OG HTML page).
# - og:image points to /api/moments/:id/share-image.jpg (JPEG proxy — works for WebP uploads).
# - Deploy backend with sharp. Redeploy frontend after backend is live.
# VITE_SHARE_PLATFORM_URL=moment

# Standalone Kult Moments app (full-page embed at /moments)
# VITE_MOMENTS_URL=https://kult-browser-moments-p5wgi.ondigitalocean.app

# AI Arena gateway (optional; default https://aiarena-gateway.onrender.com)
# VITE_AI_ARENA_GATEWAY_URL=https://aiarena-gateway.onrender.com
# Optional static bearer token for protected AI Arena routes (`/v1/agents`, `/v1/matchmaking`, etc.)
# VITE_AI_ARENA_BEARER_TOKEN=your-ai-arena-jwt

# Privy app ID — get yours at https://dashboard.privy.io
VITE_PRIVY_APP_ID=your-privy-app-id
# Optional; defaults to /tonconnect-manifest.json on the current frontend origin.
# VITE_TONCONNECT_MANIFEST_URL=https://app.kultgames.io/tonconnect-manifest.json

# Wallet / SIWE chain — 0G mainnet (matches warzonewarrior env pattern; defaults shown)
# VITE_ALLOWED_CHAIN_ID=16661
# VITE_ALLOWED_CHAIN_NAME=0G Mainnet
# VITE_ALLOWED_RPC_URL=https://evmrpc.0g.ai
# VITE_ALLOWED_EXPLORER_URL=https://chainscan.0g.ai
# VITE_ALLOWED_NATIVE_NAME=0G
# VITE_ALLOWED_NATIVE_SYMBOL=0G
# VITE_ALLOWED_NATIVE_DECIMALS=18

# Optional explicit AI endpoint override.
# If set, this takes precedence over VITE_API_URL.
# VITE_KULT_AI_API_URL=https://kult-browser-rust-l2lwg.ondigitalocean.app/assistant/v1/chat

# Local development override for the Python inference service.
# VITE_KULT_AI_API_URL=http://localhost:8000/v1/chat

# Highway Hustle backend (garage purchases/rewards/equip — ownership via HH API, not contract in this app)
# VITE_HIGHWAY_HUSTLE_API_URL=https://highway-hustle-backend.onrender.com/api
# Garage car images reuse Kult marketplace listings (`assetUrl`) from VITE_API_URL — no extra image env.

# Marketplace on-chain payment config (frontend-visible, must use VITE_ prefix)
# VITE_MARKETPLACE_CONTRACT_ADDRESS=0xYourMarketplaceAddress
# VITE_MARKETPLACE_CHAIN_ID=8453
# VITE_USDC_CONTRACT_ADDRESS=0xYourUsdcTokenAddress
# VITE_USDT_CONTRACT_ADDRESS=0xYourUsdtTokenAddress
